# Copia este archivo a .env y completa solo tus propias claves.
# Nunca subas .env al repositorio ni compartas sus valores.

# auto = Gemini gratis primero, luego Hugging Face y OpenAI como respaldo; local = sin servicios externos.
AI_PROVIDER=auto

# Gemini gratis: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opcional. Requiere creditos de pago en Hugging Face. Usa un modelo de instrucciones.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# auto = Brave, DuckDuckGo y luego Google si están disponibles. duckduckgo = gratis sin claves.
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
BRAVE_SEARCH_API_KEY=

WEB_SEARCH_ENABLED=true
WEB_SEARCH_MODE=auto

AI_TIMEOUT_MS=20000
SEARCH_TIMEOUT_MS=9000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
